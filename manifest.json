{
  "manifest_version": 3,
  "name": "FDS Inspector DEV 20260410",
  "version": "1.0.1",
  "description": "Fasoo Design System validation tool",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost:3846/*",
    "http://127.0.0.1:3846/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
