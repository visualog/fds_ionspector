{
  "manifest_version": 3,
  "name": "FDS Inspector DEV 20260410",
  "version": "1.0.1",
  "description": "Fasoo Design System validation tool",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost:3846/*",
    "http://127.0.0.1:3846/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["toolbar-state.js", "toolbar-drag.js", "style-token-detection.js", "token-source.js", "bridge-token-source.js", "design-variables.js", "content.js"],
      "css": ["overlay.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
